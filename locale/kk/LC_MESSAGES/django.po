# --- Forms

msgid "Enter a valid integer."
msgstr "Дұрыс бүтін сан енгізіңіз."

msgid "Enter a valid email address."
msgstr "Дұрыс электрондық пошта мекенжайын енгізіңіз."

msgid "Ensure this value has at least %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at least %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "Кемінде %(limit_value)d таңба болуы керек (қазір %(show_value)d)."
msgstr[1] "Кемінде %(limit_value)d таңба болуы керек (қазір %(show_value)d)."

msgid "Ensure this value has at most %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at most %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "Ең көбі %(limit_value)d таңба болуы керек (қазір %(show_value)d)."
msgstr[1] "Ең көбі %(limit_value)d таңба болуы керек (қазір %(show_value)d)."

msgid "Null characters are not allowed."
msgstr "Нөлдік таңбаларға рұқсат жоқ."

msgid "%(model_name)s with this %(field_labels)s already exists."
msgstr "Осындай %(field_labels)s мәні бар %(model_name)s бұрыннан бар."

msgid "Value %(value)r is not a valid choice."
msgstr "%(value)r мәні дұрыс таңдау емес."

msgid "Enter a complete value."
msgstr "Мәнді толық енгізіңіз."

msgid "“%(pk)s” is not a valid value."
msgstr "“%(pk)s” дұрыс мән емес."

msgid "- Select an option -"
msgstr "— Таңдаңыз —"

msgid "File"
msgstr "Файл"

msgid "Image"
msgstr "Сурет"

# --- Passwords and accounts

msgid "Enter the same password as before, for verification."
msgstr "Растау үшін құпиясөзді қайта енгізіңіз."

msgid "The two password fields didn’t match."
msgstr "Екі құпиясөз бірдей емес."

msgid "Email"
msgstr "Электрондық пошта"

msgid "email address"
msgstr "электрондық пошта"

msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "Бұл құпиясөз тым қысқа. Кемінде %d таңба болуы керек."
msgstr[1] "Бұл құпиясөз тым қысқа. Кемінде %d таңба болуы керек."

msgid "Your password must contain at least %(min_length)d character."
msgid_plural "Your password must contain at least %(min_length)d characters."
msgstr[0] "Құпиясөзде кемінде %(min_length)d таңба болуы керек."
msgstr[1] "Құпиясөзде кемінде %(min_length)d таңба болуы керек."

msgid "The password is too similar to the %(verbose_name)s."
msgstr "Құпиясөз «%(verbose_name)s» мәніне тым ұқсас."

msgid "Your password can’t be too similar to your other personal information."
msgstr "Құпиясөз жеке мәліметтеріңізге тым ұқсас болмауы керек."

msgid "This password is too common."
msgstr "Бұл құпиясөз тым жиі қолданылады."

msgid "Your password can’t be a commonly used password."
msgstr "Жиі қолданылатын құпиясөзді таңдамаңыз."

msgid "This password is entirely numeric."
msgstr "Бұл құпиясөз тек сандардан тұрады."

msgid "Your password can’t be entirely numeric."
msgstr "Құпиясөз тек сандардан тұрмауы керек."

msgid "Enter a valid username. This value may contain only letters, numbers, and @/./+/-/_ characters."
msgstr "Дұрыс логин енгізіңіз. Тек әріптер, сандар және @/./+/-/_ таңбаларын қолдануға болады."

msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr "Міндетті өріс. Ең көбі 150 таңба: әріптер, сандар және @/./+/-/_ қана."

